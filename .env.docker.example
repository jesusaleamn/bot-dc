# Token del bot. No compartas este valor y no lo subas a Git.
DISCORD_TOKEN=pon_aqui_el_token_de_discord

# Docker Compose incluye un servicio PostgreSQL llamado "db".
DATABASE_URL=postgresql+asyncpg://inventory:inventory_password@db:5432/inventory_bot

# Opcional: ID de un servidor de pruebas para que los slash commands aparezcan al instante.
COMMAND_GUILD_ID=

SYNC_COMMANDS=true
LOG_LEVEL=INFO

# Opcional. Algunos hostings asignan PORT automáticamente.
# HEALTHCHECK_PORT=8080
