# Token del bot de Discord. Necesario para crear/editar el mensaje permanente.
DISCORD_TOKEN=pon_aqui_el_token_de_discord

# Application ID de Discord Developer Portal -> General Information.
DISCORD_APPLICATION_ID=pon_aqui_application_id

# Public Key de Discord Developer Portal -> General Information.
DISCORD_PUBLIC_KEY=pon_aqui_public_key

# PostgreSQL externo. Recomendado para Netlify: Neon.
DATABASE_URL=postgresql://usuario:password@host.neon.tech/dbname?sslmode=require

# Opcional para registrar comandos solo en un servidor de pruebas.
# Si lo dejas vacío y ejecutas el script, registra comandos globales.
DISCORD_GUILD_ID=

