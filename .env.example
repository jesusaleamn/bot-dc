# Token del bot. No compartas este valor y no lo subas a Git.
DISCORD_TOKEN=pon_aqui_el_token_de_discord

# Desarrollo local sencillo con SQLite persistente.
DATABASE_URL=sqlite+aiosqlite:///data/inventory.sqlite3

# Para Docker Compose con PostgreSQL, usa esta URL en tu .env:
# DATABASE_URL=postgresql+asyncpg://inventory:inventory_password@db:5432/inventory_bot

# Opcional: ID de un servidor de pruebas para que los slash commands aparezcan al instante.
# Si lo dejas vacío, se sincronizan globalmente y pueden tardar más en aparecer.
COMMAND_GUILD_ID=

SYNC_COMMANDS=true
LOG_LEVEL=INFO

# Opcional para hostings que exigen un puerto HTTP o para comprobar salud.
# HEALTHCHECK_PORT=8080
